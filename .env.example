# Server
PORT=4000
NODE_ENV=development

# Security (REQUIRED in production: use a long random string)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Database. Local default is SQLite (no install needed).
DB_DIALECT=sqlite
DB_STORAGE=./uniserve.sqlite

# For PostgreSQL (Docker, Render, Railway, Neon, Supabase...):
# DB_DIALECT=postgres
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=true
